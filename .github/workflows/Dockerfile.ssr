FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY packages/apps/ssr/public ./packages/apps/ssr/public
COPY --chown=nextjs:nodejs packages/apps/ssr/.next/standalone ./
COPY --chown=nextjs:nodejs packages/apps/ssr/.next/static ./packages/apps/ssr/.next/static
USER nextjs
EXPOSE 8080
CMD ["node", "packages/apps/ssr/server.js"]
