FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8086
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY packages/apps/micro-nexus/public ./packages/apps/micro-nexus/public
COPY --chown=nextjs:nodejs packages/apps/micro-nexus/.next/standalone ./
COPY --chown=nextjs:nodejs packages/apps/micro-nexus/.next/static ./packages/apps/micro-nexus/.next/static
USER nextjs
EXPOSE 8086
CMD ["node", "packages/apps/micro-nexus/server.js"]
