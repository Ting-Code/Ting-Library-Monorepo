{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "clean": {
      "outputs": [],
      "dependsOn": ["^clean"]
    },
    "stub": {},
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "lint:eslint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../eslint.config.mjs",
        "../../configs/lint/eslint.mjs",
        "../../configs/lint/package.json"
      ]
    },
    "lint:eslint:check": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../eslint.config.mjs",
        "../../configs/lint/eslint.mjs",
        "../../configs/lint/package.json"
      ]
    },
    "lint:prettier": {},
    "lint:stylelint": {}
  }
}
