{
  "version": "2.11",
  "children": [
    {
      "id": "route-detail",
      "type": "frame",
      "name": "Route /i18n/editor/:namespace → src/views/detail/index.vue",
      "x": 80,
      "y": 80,
      "width": 1200,
      "height": 760,
      "fill": "$color.page-bg",
      "layout": "none",
      "clip": true,
      "children": [
        {
          "id": "back-title",
          "type": "text",
          "x": 24,
          "y": 24,
          "content": "← 项目 · layout",
          "fill": "$color.text-title",
          "fontSize": 18,
          "fontWeight": "600",
          "textGrowth": "auto"
        },
        {
          "id": "tag-project",
          "type": "text",
          "x": 24,
          "y": 58,
          "content": "项目：layout",
          "fill": "$color.text-secondary",
          "fontSize": 12,
          "textGrowth": "auto"
        },
        {
          "id": "tag-zh",
