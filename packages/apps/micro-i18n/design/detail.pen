          "x": 120,
          "y": 54,
          "width": 64,
          "height": 24,
          "fill": "$color.input-bg",
          "cornerRadius": 4,
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.primary"
          }
        },
        {
          "id": "tag-zh-label",
