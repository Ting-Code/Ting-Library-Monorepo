{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "tokens-board",
      "x": 0,
      "y": 0,
      "name": "i18n 主题 Token 预览（右上角切换 default / dark）",
      "theme": {
        "mode": "dark"
      },
      "clip": true,
      "width": 520,
      "height": 720,
      "fill": "$color.page-bg",
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "tokens-title",
          "x": 24,
          "y": 20,
          "fill": "$color.text-title",
