{
  "name": "@config/lint",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "commitlint.js",
    "eslint.mjs",
    "lintstaged.js",
    "prettier.js",
    "stylelint.js"
  ],
  "scripts": {
    "clean": "pnpm rimraf node_modules && pnpm rimraf dist && pnpm rimraf .turbo",
    "lint:eslint": "eslint . --cache --max-warnings 0 --fix",
    "lint:eslint:check": "eslint . --cache --max-warnings 0",
    "lint:prettier": "prettier --write --cache --ignore-unknown --ignore-path=../../.prettierignore ."
  },
  "dependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "commitizen": "^4.2.4",
    "commitlint-config-cz": "^0.13.3",
    "commitlint-config-git-commit-emoji": "^1.0.0",
    "cz-customizable": "^7.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.0.11",
    "lint-staged": "15.2.2",
    "postcss": "^8.4.35",
    "postcss-html": "^1.6.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0"
  }
}
